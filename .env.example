# --- Nebius Token Factory (https://nebius.com / Token Factory dashboard) ---
# OpenAI-compatible base URL, e.g. the URL shown in the Token Factory dashboard
NEBIUS_BASE_URL=
NEBIUS_API_KEY=
# Exact model IDs as listed in Token Factory — copy from the dashboard/playground
# Recommended: NEBIUS_MODEL_REASONING=Nemotron-3-Ultra-550b-a55b (analyst, 1 call/report)
#              NEBIUS_MODEL_FAST=Nemotron-3.5-Lightning (planner + summarizer, fast & cheap)
NEBIUS_MODEL_REASONING=
NEBIUS_MODEL_FAST=

# --- Tavily (https://tavily.com) ---
TAVILY_API_KEY=

# --- Cost estimation (optional, $ per 1M tokens) ---
# Defaults = Token Factory list prices (Oct 2026, confirmed from dashboard):
#   fast (Nemotron-3.5-Lightning): $0.06 in / $0.24 out
#   reasoning (Nemotron-3-Ultra-550b-a55b): $1.00 in / $3.00 out
#DOWORACLE_PRICE_FAST_IN=0.06
#DOWORACLE_PRICE_FAST_OUT=0.24
#DOWORACLE_PRICE_REASONING_IN=1.00
#DOWORACLE_PRICE_REASONING_OUT=3.00
# $ per Tavily credit (docs.tavily.com/documentation/api-credits)
#DOWORACLE_TAVILY_CREDIT_USD=0.008
